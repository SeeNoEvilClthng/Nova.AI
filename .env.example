PORT=4180
APP_URL=http://localhost:4180
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose this value in browser code.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional locally. Vercel deployments authenticate to AI Gateway with OIDC.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-sol
# For non-Vercel hosts, AI Gateway can instead use a server-only gateway key.
# AI_GATEWAY_API_KEY=...
# Free-tier default. Upgrade to openai/gpt-5.6-sol after purchasing Gateway credits.
AI_GATEWAY_MODEL=inclusionai/ling-3.0-flash-free

# Use test-mode Stripe values until the complete flow has been verified.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_BUILDER_PRICE_ID=price_...
STRIPE_OPERATOR_PRICE_ID=price_...
# Production must be an explicit deployment decision. Leave unset in development.
# ALLOW_STRIPE_LIVE=true
