PORT=4180
APP_URL=http://localhost:4180
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose this value in browser code.
SUPABASE_SECRET_KEY=sb_secret_...
# Server-only key used to sign immutable Autopilot verification receipts.
EXECUTION_RECEIPT_SECRET=replace-with-a-long-random-secret

# Scoped third-party access managed by Vercel Connect.
VERCEL_CONNECT_GITHUB_CONNECTOR=github/nova-ai
VERCEL_CONNECT_EMAIL_CONNECTOR=
VERCEL_CONNECT_MARKETING_CONNECTOR=
VERCEL_CONNECT_X_CONNECTOR=
VERCEL_CONNECT_FACEBOOK_CONNECTOR=
VERCEL_CONNECT_INSTAGRAM_CONNECTOR=
META_APP_ID=
META_APP_SECRET=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_INSTAGRAM_USERNAME=builtwithnova
# Server-only token generated by Meta's Instagram Login API setup.
INSTAGRAM_ACCESS_TOKEN=
# Pin this to the Graph API version enabled for your Meta app (for example vXX.X).
META_GRAPH_VERSION=v26.0
# 32-byte key encoded as 64 hexadecimal characters. Encrypts per-user OAuth
# tokens before they are stored in Supabase.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Optional locally. Vercel deployments authenticate to AI Gateway with OIDC.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-sol
# For non-Vercel hosts, AI Gateway can instead use a server-only gateway key.
# AI_GATEWAY_API_KEY=...
# Current free-tier route. Nova.Ai tries the fallback automatically if the primary is unavailable.
AI_GATEWAY_MODEL=inclusionai/ling-3.0-tiny-free
AI_GATEWAY_FALLBACK_MODELS=poolside/laguna-s-2.1-free
# Upgrade the primary to openai/gpt-5.4 after purchasing Gateway credits.

# Use test-mode Stripe values until the complete flow has been verified.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_BUILDER_PRICE_ID=price_...
STRIPE_OPERATOR_PRICE_ID=price_...
# Production must be an explicit deployment decision. Leave unset in development.
# ALLOW_STRIPE_LIVE=true
