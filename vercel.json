{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "nova-ai": {
      "root": ".",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "nova-ai" } }
  ],
  "crons": [
    { "path": "/api/cron/reseller-campaigns", "schedule": "0 17 * * *" }
  ]
}
