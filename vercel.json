{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "nova-ai": {
      "root": ".",
      "entrypoint": "src/index.ts",
      "includeFiles": [
        "*.html",
        "*.css",
        "*.js",
        "*.png"
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "nova-ai" } }
  ]
}
